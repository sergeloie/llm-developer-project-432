# LLM (OpenAI-совместимый API: LM Studio / OpenRouter / Ollama)
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=gemma-4-e4b-it
LLM_MODEL_CHEAP=gemma-4-e4b-it

# БД (если 5432 занят другим Postgres — смени PG_PORT)
PG_PORT=5433
DATABASE_URL=postgresql://card:card@localhost:5433/card

# Движок устойчивого исполнения (TEMPORAL_PORT и TEMPORAL_UI_PORT читает docker-compose)
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
TEMPORAL_HOST=localhost:7233
TEMPORAL_TASK_QUEUE=card-queue

# Embeddings (модель скачается при первом запуске)
EMBED_MODEL=google/embeddinggemma-300m
EMBED_DIM=768

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_THRESHOLD=0.35

# cpu | mps. mps не работает в дочерних процессах: PyTorch с Metal падает при fork,
# первый эмбеддинг проходит, следующий роняет воркер.
EMBED_DEVICE=cpu

# Guardrails
SUSPICIOUS_CHUNK_LIMIT=2
