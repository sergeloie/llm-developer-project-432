# Copy to `.env` and adjust. `.env` is never committed; this file is.

# --- Host ports for the compose stack -----------------------------------------
# Defaults are the conventional values. Override when they collide with a local
# PostgreSQL install or another stack.
PG_PORT=5432
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

# --- Database ------------------------------------------------------------------
# Must match the compose service. `localhost` is wrong here on purpose: on Windows it
# resolves to ::1 first, and a server bound only to IPv4 refuses the connection with an
# error that never mentions addressing. See ADR-0007.
CARD_DB_URL=jdbc:postgresql://127.0.0.1:5432/card
CARD_DB_USER=card
CARD_DB_PASSWORD=card
CARD_DB_POOL_SIZE=10

# --- Model server --------------------------------------------------------------
# The OpenAI-compatible local server. `qwen/qwen3.5-9b` is the main tier and
# `qwen/qwen3-4b-2507` the utility tier; see ADR-0006 for why no other model is eligible.
# The /v1 suffix is required. Without it the SDK posts to /chat/completions and this server
# answers HTTP 200 with an error object, which surfaces as "choices is not set" rather than as a
# wrong-address error.
CARD_LLM_BASE_URL=http://127.0.0.1:1234/v1
CARD_LLM_API_KEY=lm-studio
CARD_LLM_MAIN_MODEL=qwen/qwen3.5-9b
CARD_LLM_UTILITY_MODEL=qwen/qwen3-4b-2507
CARD_LLM_TIMEOUT=120s
CARD_LLM_MAX_ATTEMPTS=3
CARD_LLM_RETRY_BASE_DELAY=500ms
CARD_LLM_RETRY_MAX_DELAY=8s
# Price per one million tokens. Local models are free; set these to the reference cloud
# price of the same model to make the cost breakdown meaningful without moving off-device.
CARD_LLM_MAIN_INPUT_PRICE_PER_MTOK=0
CARD_LLM_MAIN_OUTPUT_PRICE_PER_MTOK=0
CARD_LLM_UTILITY_INPUT_PRICE_PER_MTOK=0
CARD_LLM_UTILITY_OUTPUT_PRICE_PER_MTOK=0

# --- Embeddings ---------------------------------------------------------------
CARD_EMBEDDING_MODEL=text-embedding-embeddinggemma-300m
CARD_EMBEDDING_DIMENSION=768
CARD_EMBEDDING_BATCH_SIZE=16
# Task prefixes, taken from the model card. The document side has a title slot, which is
# filled with the chunk's section. See ADR-0002.
CARD_EMBEDDING_QUERY_PREFIX=task: search result | query:
CARD_EMBEDDING_DOCUMENT_PREFIX=title: none | text:

# --- Chunking ------------------------------------------------------------------
CARD_CHUNK_SIZE=1200
CARD_CHUNK_OVERLAP=200

# --- Retrieval -----------------------------------------------------------------
# Calibrated against the reference set, and a test fails if it drifts out of range.
# See ticket 06 for the derivation and ticket 05/06 for the measured justification.
CARD_SEARCH_RELEVANCE_THRESHOLD=0.35
CARD_SEARCH_HYBRID_RRF_K=60

# --- Generation ----------------------------------------------------------------
CARD_GENERATION_MAX_REWRITE_ROUNDS=3
CARD_GENERATION_CONFIDENCE_THRESHOLD=0.7
CARD_GENERATION_MAX_REPAIR_ATTEMPTS=2

# --- Context -------------------------------------------------------------------
CARD_CONTEXT_MAX_CHUNKS=12

# --- Security ------------------------------------------------------------------
CARD_SECURITY_MAX_SUSPICIOUS_CHUNKS=2

# --- Process engine -----------------------------------------------------------
CARD_TEMPORAL_ADDRESS=127.0.0.1:7233
CARD_TEMPORAL_NAMESPACE=default
CARD_TEMPORAL_TASK_QUEUE=card-drafting
