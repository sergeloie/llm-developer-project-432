# LLM (LM Studio, OpenAI-compatible)
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL_MAIN=qwen/qwen3.5-9b
LLM_MODEL_CHEAP=qwen/qwen3-4b-2507
LLM_TIMEOUT_S=300
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=2048

# Цена за 1M токенов, копейки (integer), для стоимости вызовов
PRICE_MAIN_INPUT_KOPEK=0
PRICE_MAIN_OUTPUT_KOPEK=0
PRICE_CHEAP_INPUT_KOPEK=0
PRICE_CHEAP_OUTPUT_KOPEK=0

# База (pgvector)
DATABASE_URL=postgresql://card:card@localhost:5432/card

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_TASK_QUEUE=card-queue

# Эмбеддинги (LM Studio /v1/embeddings)
EMB_MODEL=text-embedding-embeddinggemma-300m
EMB_DIM=768
EMB_TIMEOUT_S=120

# Поиск
SEARCH_RELEVANCE_THRESHOLD=0.45
CONTEXT_CHAR_LIMIT=12000
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Контракт карточки
CARD_TITLE_MAX_LEN=60
CONFIDENCE_HUMAN_THRESHOLD=0.7
MAX_REPAIR_ATTEMPTS=3
MAX_PIPELINE_ROUNDS=3

# Защита (шаг 9)
MAX_SUSPICIOUS_PER_DOC=3
