# Copy to `.env` and adjust. `.env` is never committed; this file is.

# --- Host ports for the compose stack -----------------------------------------
# Defaults are the conventional values. Override when they collide with a local
# PostgreSQL install or another stack.
PG_PORT=5432
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

# --- Database ------------------------------------------------------------------
# Must match the compose service. `localhost` is wrong here on purpose: on Windows it
# resolves to ::1 first, and a server bound only to IPv4 refuses the connection with an
# error that never mentions addressing. See ADR-0007.
CARD_DB_URL=jdbc:postgresql://127.0.0.1:5432/card
CARD_DB_USER=card
CARD_DB_PASSWORD=card
CARD_DB_POOL_SIZE=10

# --- Model server --------------------------------------------------------------
# The OpenAI-compatible local server. `qwen/qwen3.5-9b` is the main tier and
# `qwen/qwen3-4b-2507` the utility tier; see ADR-0006 for why no other model is eligible.
# The /v1 suffix is required. Without it the SDK posts to /chat/completions and this server
# answers HTTP 200 with an error object, which surfaces as "choices is not set" rather than as a
# wrong-address error.
CARD_LLM_BASE_URL=http://127.0.0.1:1234/v1
CARD_LLM_API_KEY=lm-studio
CARD_LLM_MAIN_MODEL=qwen/qwen3.5-9b
CARD_LLM_UTILITY_MODEL=qwen/qwen3-4b-2507
CARD_LLM_TIMEOUT=120s
CARD_LLM_MAX_ATTEMPTS=3
CARD_LLM_RETRY_BASE_DELAY=500ms
CARD_LLM_RETRY_MAX_DELAY=8s
# Price per one million tokens, per tier, as an exact decimal.
# Local models are free, and a rate of zero exercises none of the cost arithmetic - so a bug in it
# would sit hidden until the day this pointed at a paid model. CostCalculatorTest therefore uses
# non-zero rates and proves the paid path before it is used.
# Twelve decimal places in the column, not eight: one token costs price/1000000, so at 0.01 per
# million a single-token call is exactly 0.00000001 and an eight-place column would round it away.
CARD_LLM_MAIN_INPUT_PRICE_PER_MILLION=0
CARD_LLM_MAIN_OUTPUT_PRICE_PER_MILLION=0
CARD_LLM_UTILITY_INPUT_PRICE_PER_MILLION=0
CARD_LLM_UTILITY_OUTPUT_PRICE_PER_MILLION=0

# --- Embeddings ---------------------------------------------------------------
# Served by the local model server on the same OpenAI-compatible endpoint as generation.
CARD_EMBEDDING_BASEURL=http://127.0.0.1:1234
CARD_EMBEDDING_MODEL=text-embedding-embeddinggemma-300m
# Must match the vector column's width, or every search fails on a dimension mismatch.
CARD_EMBEDDING_DIMENSION=768
CARD_EMBEDDING_BATCHSIZE=16
# Embed chunks that predate the search columns. Off by default: a restart should not
# silently depend on a model server being up.
CARD_EMBEDDING_BACKFILLONSTART=false
# Task prefixes are not exposed here. They contain spaces and a trailing space, neither of
# which survives an environment variable reliably; they live in application.yml, taken from
# the model card. See ADR-0002 for why they are applied by this service rather than the model.

# --- Chunking ------------------------------------------------------------------
CARD_CHUNK_SIZE=1200
CARD_CHUNK_OVERLAP=200

# --- Retrieval -----------------------------------------------------------------
# PROVISIONAL. The lower bound is measured: every reference probe in data/golden_cards.json is
# within this distance (worst 0.764, blender_kp.docx / BLD-800). The upper bound is not - nothing
# yet measures how far an UNRELATED fragment sits, so this is known to be generous rather than
# known to be right. EmbeddingThresholdCalibrationTest enforces the lower bound and fails if this
# drifts below it. Raise it only with a measurement behind it.
CARD_SEARCH_MAXVECTORDISTANCE=0.8
# Both default to 8, and perListLimit must be >= limit or the fusion returns a short page.
CARD_SEARCH_PERLISTLIMIT=8
CARD_SEARCH_LIMIT=8
# Rank-fusion constant from the original paper. Not tuned, so do not adjust it to chase scores.
CARD_SEARCH_RRFK=60

# --- Generation ----------------------------------------------------------------
CARD_GENERATION_MAX_REWRITE_ROUNDS=3
CARD_GENERATION_CONFIDENCE_THRESHOLD=0.7
# Bounded repair of a malformed answer belongs to the model client, so it is named under LLM.
CARD_LLM_MAX_REPAIR_ATTEMPTS=2

# --- Context -------------------------------------------------------------------
CARD_CONTEXT_MAX_CHUNKS=12
CARD_CONTEXT_MAX_CHARACTERS=12000

# --- Security ------------------------------------------------------------------
CARD_TRUST_MAX_SUSPICIOUS_CHUNKS=2

# --- Process engine -----------------------------------------------------------
# The engine's address. There is no mode in which this application starts its own engine, so this
# has to resolve to something running: `docker compose up`, or `temporal server start-dev` on the
# same port. Must match TEMPORAL_PORT above when the compose stack is shifted.
CARD_TEMPORAL_TARGET=127.0.0.1:7233
CARD_TEMPORAL_NAMESPACE=default
CARD_TEMPORAL_TASK_QUEUE=card-drafting
# How many activities may touch the model server at once. The default 200 assumes a
# provider that scales; a laptop GPU engine does not, and parallel generations fail
# it with transient 400s instead of queuing. 2 lets a card and a metrics run overlap
# without choking the engine. Needs an application restart to take effect.
CARD_TEMPORAL_MAX_ACTIVITY_THREADS=2
