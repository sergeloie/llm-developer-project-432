# Каждая переменная ниже — поле app/core/config.py Settings (имя переменной
# совпадает с именем поля в верхнем регистре). Скопируй в .env и правь под себя.

# LLM (OpenAI-совместимый API: LM Studio / OpenRouter / Ollama)
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen/qwen3.5-9b
LLM_MODEL_CHEAP=qwen/qwen3-4b-2507
LLM_TIMEOUT_S=300
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.4

# Цены за 1M токенов в USD. PRICE_DEFAULT_* — для любой модели без явной цены.
# PRICE_<MODEL>_INPUT / PRICE_<MODEL>_OUTPUT, где <MODEL> — идентификатор модели
# из LLM_MODEL, приведённый к виду "нижний регистр, не-буквы → _".
# Например, qwen/qwen3.5-9b → PRICE_QWEN_QWEN3_5_9B_INPUT.
PRICE_DEFAULT_INPUT=0
PRICE_DEFAULT_OUTPUT=0

# БД
DATABASE_URL=postgresql://card:card@localhost:5433/card
DB_POOL_MIN=1
DB_POOL_MAX=10

# Движок устойчивого исполнения
TEMPORAL_HOST=localhost:7233
TEMPORAL_TASK_QUEUE=card-queue
TEMPORAL_ACTIVITY_THREADS=4

# Embeddings. lmstudio — OpenAI-совместимый API: модель уже загружена локально,
# ничего не скачивается. hf — sentence-transformers, веса качаются при первом
# запуске. EMBED_BASE_URL / EMBED_API_KEY пустые → берутся из LLM_*.
EMBED_BACKEND=lmstudio
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-embeddinggemma-300m
EMBED_DIM=768
EMBED_TIMEOUT_S=300
# cpu | mps. mps не работает в дочерних процессах: PyTorch с Metal падает при fork,
# первый эмбеддинг проходит, следующий роняет воркер.
EMBED_DEVICE=cpu

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_THRESHOLD=0.35

# Chunking и контекст
CHUNK_SIZE=700
CHUNK_OVERLAP=120
CONTEXT_CHAR_LIMIT=6000

# Карточка и пайплайн
CARD_TITLE_MAX_LEN=60
CONFIDENCE_HUMAN_THRESHOLD=0.5
# Доля характеристик, подтверждённых источником, ниже которой карточка
# отправляется человеку вместо статуса done.
SOURCE_COVERAGE_THRESHOLD=0.8
MAX_FIX_ATTEMPTS=2
MAX_PIPELINE_ROUNDS=3

# Guardrails и загрузка
SUSPICIOUS_CHUNK_LIMIT=2
UPLOAD_MAX_MB=10

# Переменные docker compose, а не приложения (compose читает .env сам).
# Если 5432 занят другим Postgres — смени PG_PORT.
PG_PORT=5433
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233